{
    "name": "karnoweb/laravel-wallet",
    "description": "Laravel Wallet & Credit package: owner-centric global wallets with credit lineage, allocations, FIFO spending, transfers, grants, refunds and expirations. Accounting-agnostic by design.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "wallet",
        "credit",
        "ledger",
        "finance"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\Wallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\Wallet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\Wallet\\WalletServiceProvider"
            ],
            "aliases": {
                "Wallet": "Karnoweb\\Wallet\\Facades\\Wallet"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
